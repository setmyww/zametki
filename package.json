{
  "name": "zametki",
  "productName": "Заметки",
  "version": "1.3.0",
  "description": "Заметки и списки для Windows",
  "main": "main.js",
  "author": "Zametki",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.local.zametki",
    "productName": "Заметки",
    "executableName": "Zametki",
    "artifactName": "Zametki-Setup-${version}.${ext}",
    "files": ["main.js", "preload.js", "index.html", "app.js", "styles.css", "icon.png"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Заметки"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
